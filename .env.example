# ==============================================================================
# NEXUS FOCUS - VARIÁVEIS DE AMBIENTE (RELEASE CANDIDATE)
# ==============================================================================
# Copie este arquivo para .env no desenvolvimento local.
# Para produção, configure as seções abaixo nos respectivos painéis (Vercel e Render).

# ==============================================================================
# 1. FRONTEND (Configure no painel da VERCEL)
# Todas as variáveis do cliente Vite DEVEM começar com o prefixo VITE_
# ==============================================================================

# URL pública do backend na Render (ex: https://nexus-focus.onrender.com)
VITE_API_URL="https://seu-backend.onrender.com"

# Chave Pública do Mercado Pago para o Checkout Bricks (SDK React)
VITE_MERCADOPAGO_PUBLIC_KEY="APP_USR-sua-chave-publica-aqui"

# Número oficial do WhatsApp do Mentor Focus (+55 (31) 9005-4794)
VITE_WHATSAPP_BOT_PHONE="+55 (31) 9005-4794"

# (Opcional) Chave da API do Google Gemini para o Mentor Focus no cliente
VITE_GEMINI_API_KEY=""

# (Opcional) Configurações do Firebase Client SDK (caso queira sobrescrever firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN="planner-com-ia-assistant.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="planner-com-ia-assistant"
# VITE_FIREBASE_STORAGE_BUCKET="planner-com-ia-assistant.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="16899628445"
# VITE_FIREBASE_APP_ID="1:16899628445:web:90c81f0e8213c541a12374"
# VITE_FIREBASE_MEASUREMENT_ID="G-YFG7KW5RLK"


# ==============================================================================
# 2. BACKEND (Configure no painel do RENDER - Web Service)
# Variáveis utilizadas pela API Express (server.ts)
# ==============================================================================

# Porta do servidor Express (a Render define automaticamente; default: 3000)
PORT=3000

# URL pública do frontend hospedado (usado para CORS, redirecionamentos e webhooks)
APP_URL="https://seu-app.vercel.app"

# E-mail mestre de administração do sistema (possui privilégios de concessão Pro)
ADMIN_EMAIL="phillipe.souza27@gmail.com"

# --- FIREBASE ADMIN SDK ---
# Cole o conteúdo JSON da chave da conta de serviço (Service Account Key) exportada do Firebase Console
# Dica: Pode ser colado em formato JSON string puro ou codificado em Base64
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"planner-com-ia-assistant","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'
FIREBASE_PROJECT_ID="planner-com-ia-assistant"

# --- GOOGLE GEMINI AI ---
# Chave da API do Google Gemini (Google AI Studio) utilizada pelos endpoints de chat e mentor
GEMINI_API_KEY=""

# --- OPENAI (Opcional) ---
# Chave da API OpenAI caso utilize modelos OpenAI no backend
OPENAI_API_KEY=""

# --- MERCADO PAGO ---
# Token de acesso de produção ou homologação do Mercado Pago (APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-seu-access-token-aqui"

# Segredo para validação de webhook HMAC x-signature configurado no painel de desenvolvedor do MP
MERCADOPAGO_WEBHOOK_SECRET=""

# Valor padrão da assinatura mensal em Reais (R$)
SUBSCRIPTION_AMOUNT=19.90

# (Opcional) ID de plano pré-aprovado de assinatura recorrente no Mercado Pago
# MERCADOPAGO_PLAN_ID=""

# --- STRIPE (Opcional / Gateway Secundário) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
STRIPE_CHECKOUT_URL=""

# --- META WHATSAPP CLOUD API ---
# Token de Acesso do Meta for Developers (Graph API)
META_ACCESS_TOKEN=""

# ID do Número de Telefone do WhatsApp Business (ex: 1311385455400755)
META_PHONE_NUMBER_ID=""

# Token de Verificação do Webhook configurado no painel da Meta
META_WEBHOOK_VERIFY_TOKEN="nexus_flow_whatsapp_secure_focus_5263"

# Chave Secreta do Aplicativo Meta (App Secret) para validação x-hub-signature-256
META_APP_SECRET=""

# --- WEB PUSH NOTIFICATIONS (VAPID) ---
# Gerados via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- RESEND EMAIL API ---
RESEND_API_KEY="re_seu_api_key_aqui"


# Optional one-time recovery owner for pre-UID browser cache. Never infer ownership from the next login.
# VITE_LEGACY_STORAGE_OWNER_UID="verified-original-firebase-uid"
