rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // REGRA DE OURO DO ISOLAMENTO ESTRITO DE DADOS (P0 SECURITY SHIELD)
    // =========================================================================
    // Um usuário autenticado SÓ PODE ler e escrever no documento e subcoleções
    // que correspondem EXATAMENTE ao seu próprio UID oficial do Firebase Auth.
    // Qualquer tentativa de State Bleed ou acesso cruzado entre usuários é
    // bloqueada sumariamente pelo motor do Firestore no nível do banco.
    // =========================================================================
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // =========================================================================
    // COLEÇÃO DE CUPONS (Sistema de Descontos e Homologação)
    // =========================================================================
    match /coupons/{couponCode} {
      allow read: if request.auth != null;
      allow write: if false; // Escrita permitida exclusivamente via Firebase Admin SDK
    }

    // =========================================================================
    // COLEÇÃO DE COFRES COMPARTILHADOS (Controle Familiar)
    // =========================================================================
    match /ledgers/{ledgerId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        request.auth.uid in resource.data.members ||
        resource.data.ownerUid == request.auth.uid
      );

      match /{document=**} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.ownerUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.members
        );
      }
    }

    // =========================================================================
    // CONVITES DO COFRE FAMILIAR
    // =========================================================================
    match /family_invites/{inviteCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Bloqueio categórico por padrão para todas as outras coleções não mapeadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
