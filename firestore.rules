rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPERS DE AUTENTICAÇÃO E GOVERNANÇA ADMINISTRATIVA
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Verifica Custom Claim JWT (request.auth.token.admin == true) com fallback seguro
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'phillipe.souza27@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Impede que o cliente manipule campos sensíveis de faturamento/privilégio via DevTools
    function doesNotEscalatePrivileges() {
      let protectedFields = ['role', 'isAdmin', 'isPremium', 'plan', 'status', 'lifetimeAccess', 'subscriptionId', 'subscriptionStatus'];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields);
    }

    function validInitialUserCreate() {
      let protectedFields = ['isAdmin', 'isPremium', 'lifetimeAccess', 'subscriptionId'];
      return !request.resource.data.keys().hasAny(protectedFields) &&
             request.resource.data.get('role', 'user') == 'user' &&
             request.resource.data.get('plan', 'free') in ['free', 'none', ''];
    }

    // =========================================================================
    // REGRA DE OURO DO ISOLAMENTO ESTRITO DE DADOS (P0 SECURITY SHIELD)
    // =========================================================================
    // Usuários comuns leem/escrevem apenas em seu próprio UID.
    // Administradores (request.auth.token.admin == true) têm leitura global.
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && validInitialUserCreate());
      allow update: if isAdmin() || (isOwner(userId) && doesNotEscalatePrivileges());
      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // LEITURA GLOBAL DE SUBCOLEÇÕES PARA ADMIN (Collection Group Queries)
    // =========================================================================
    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin();
    }

    match /{path=**}/tasks/{taskId} {
      allow read: if isAdmin();
    }

    // =========================================================================
    // COLEÇÕES GLOBAIS DE FATURAMENTO, ASSINATURAS E TRANSAÇÕES (Admin Global Read)
    // =========================================================================
    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /payments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /confirmed_payments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payment_orders/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // COLEÇÃO DE CUPONS (Sistema de Descontos e Homologação)
    // =========================================================================
    match /coupons/{couponCode} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================================
    // CACHE DE MÉTRICAS DO PAINEL ADMIN (Single Source of Truth: Mercado Pago)
    // Documento: admin/metrics_cache (TTL de 4 horas)
    // =========================================================================
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // LOGS E AUDITORIA DE SISTEMA
    // =========================================================================
    match /logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // COLEÇÃO DE COFRES COMPARTILHADOS (Controle Familiar)
    // =========================================================================
    match /ledgers/{ledgerId} {
      allow read, write: if isAdmin() || (request.auth != null && (
        resource == null ||
        request.auth.uid in resource.data.members ||
        resource.data.ownerUid == request.auth.uid
      ));

      match /{document=**} {
        allow read, write: if isAdmin() || (request.auth != null && (
          get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.ownerUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.members
        ));
      }
    }

    // =========================================================================
    // CONVITES DO COFRE FAMILIAR
    // =========================================================================
    match /family_invites/{inviteCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Bloqueio categórico por padrão para todas as outras coleções não mapeadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
