rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPERS DE AUTENTICAÇÃO E GOVERNANÇA ADMINISTRATIVA
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'phillipe.souza27@gmail.com' ||
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Impede que o cliente manipule campos sensíveis de faturamento/privilégio via DevTools
    function doesNotEscalatePrivileges() {
      let protectedFields = ['role', 'isPremium', 'plan', 'status', 'lifetimeAccess', 'subscriptionId', 'subscriptionStatus'];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields);
    }

    function validInitialUserCreate() {
      let protectedFields = ['isPremium', 'lifetimeAccess', 'subscriptionId'];
      return !request.resource.data.keys().hasAny(protectedFields) &&
             request.resource.data.get('role', 'user') == 'user' &&
             request.resource.data.get('plan', 'free') in ['free', 'none', ''];
    }

    // =========================================================================
    // REGRA DE OURO DO ISOLAMENTO ESTRITO DE DADOS (P0 SECURITY SHIELD)
    // =========================================================================
    // Um usuário autenticado SÓ PODE ler e escrever no documento e subcoleções
    // que correspondem EXATAMENTE ao seu próprio UID oficial do Firebase Auth,
    // sem poder alterar seus próprios campos de assinatura/admin no client-side.
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && validInitialUserCreate());
      allow update: if isAdmin() || (isOwner(userId) && doesNotEscalatePrivileges());
      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // COLEÇÃO DE CUPONS (Sistema de Descontos e Homologação)
    // =========================================================================
    match /coupons/{couponCode} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // Escrita permitida apenas via Admin SDK ou Painel Admin
    }

    // =========================================================================
    // COLEÇÕES DE AUDITORIA, ASSINATURAS E PAGAMENTOS (Somente Backend / Admin)
    // =========================================================================
    match /payments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /confirmed_payments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payment_orders/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /subscriptions/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // COLEÇÃO DE COFRES COMPARTILHADOS (Controle Familiar)
    // =========================================================================
    match /ledgers/{ledgerId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        request.auth.uid in resource.data.members ||
        resource.data.ownerUid == request.auth.uid
      );

      match /{document=**} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.ownerUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.members
        );
      }
    }

    // =========================================================================
    // CONVITES DO COFRE FAMILIAR
    // =========================================================================
    match /family_invites/{inviteCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Bloqueio categórico por padrão para todas as outras coleções não mapeadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
